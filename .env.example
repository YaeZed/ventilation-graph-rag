# ── 大模型 API 配置 ───────────────────────────────────────────
# 建议使用阿里云通义千问 (Qwen)，或任何兼容 OpenAI 格式的 API
DASHSCOPE_API_KEY=sk-your-api-key-here
LLM_MODEL=qwen-plus
QWEN_VL_MODEL=qwen3.5-omni-plus

# ── 图数据库配置 (Neo4j) ──────────────────────────────────────
# 与 docker-compose.yml 保持一致
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=160722yaesakura

# ── 向量数据库配置 (Milvus) ───────────────────────────────────
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=ventilation_safety
